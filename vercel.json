{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "buildCommand":  "bun run build",
    "outputDirectory":  "dist",
    "framework":  "vite",
    "cleanUrls":  true,
    "trailingSlash":  false,
    "rewrites":  [
                     {
                         "source":  "/(.*)",
                         "destination":  "/index.html"
                     }
                 ],
    "headers":  [
                    {
                        "source":  "/assets/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=31536000, immutable"
                                        }
                                    ]
                    }
                ],
    "installCommand":  "bun install --frozen-lockfile"
}
